<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <Button
        android:id="@+id/btnQ1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Student Registration Form"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnQ2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Login Screen"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnQ3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Student Profile Screen"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnQ4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. City Selection"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnQ5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5. Language Selection" />

</LinearLayout>