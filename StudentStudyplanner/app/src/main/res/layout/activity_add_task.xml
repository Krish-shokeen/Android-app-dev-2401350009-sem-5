<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    tools:context=".AddTaskActivity">

    <!-- Top Toolbar area mimicking the green mockup top bar, using theme's teal accent -->
    <!-- We use an AppBarLayout with fitsSystemWindows="true" to automatically pad the content down below the notch/status bar, while extending the background color to the top edge -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/teal"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_add_task"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@id/ivBack"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:contentPadding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Task Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="4dp"
                            android:src="@drawable/ic_task_doc"
                            app:tint="@color/textColorPrimary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/task_title_label"
                                android:textColor="@color/textColorPrimary"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etTaskName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/task_title_hint"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textColor="@color/textColorPrimary"
                                android:textColorHint="@color/textColorSecondary"
                                android:backgroundTint="@color/progressTrackColor" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Task Description -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="24dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="4dp"
                            android:src="@drawable/ic_task_doc"
                            app:tint="@color/textColorPrimary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/task_desc_label"
                                android:textColor="@color/textColorPrimary"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etTaskDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/task_desc_hint"
                                android:inputType="textMultiLine"
                                android:lines="3"
                                android:gravity="top|start"
                                android:textColor="@color/textColorPrimary"
                                android:textColorHint="@color/textColorSecondary"
                                android:backgroundTint="@color/progressTrackColor" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Subject (RadioGroup) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="24dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="4dp"
                            android:src="@drawable/ic_subject" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/select_subject"
                                android:textColor="@color/textColorPrimary"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp" />

                            <RadioGroup
                                android:id="@+id/rgSubject"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <RadioButton
                                    android:id="@+id/rbJava"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/subject_java"
                                    android:textColor="@color/textColorPrimary"
                                    android:buttonTint="@color/teal"
                                    android:checked="true"/>
                                <RadioButton
                                    android:id="@+id/rbAndroid"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/subject_android"
                                    android:textColor="@color/textColorPrimary"
                                    android:buttonTint="@color/teal"/>
                                <RadioButton
                                    android:id="@+id/rbCProg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/subject_cprog"
                                    android:textColor="@color/textColorPrimary"
                                    android:buttonTint="@color/teal"/>
                            </RadioGroup>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Priority (Checkboxes) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="24dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="4dp"
                            android:src="@drawable/ic_flag" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/priority_label"
                                android:textColor="@color/textColorPrimary"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp" />

                            <CheckBox
                                android:id="@+id/cbImportant"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/priority_important"
                                android:textColor="@color/textColorPrimary"
                                android:buttonTint="@color/teal" />
                            <CheckBox
                                android:id="@+id/cbPractice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/priority_practice"
                                android:textColor="@color/textColorPrimary"
                                android:buttonTint="@color/teal" />
                            <CheckBox
                                android:id="@+id/cbAssignment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/priority_assignment"
                                android:textColor="@color/textColorPrimary"
                                android:buttonTint="@color/teal" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Select Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_event" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="@string/select_date_label"
                            android:textColor="@color/textColorPrimary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_date"
                            android:textColor="@color/teal"
                            android:textStyle="bold"
                            android:padding="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- Select Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_time" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="@string/select_time_label"
                            android:textColor="@color/textColorPrimary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_time"
                            android:textColor="@color/teal"
                            android:textStyle="bold"
                            android:padding="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- Save Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSave"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="32dp"
                        android:text="@string/save_task_btn"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/teal" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>